# Variables de Entorno — Ciancia Producciones

# Groq Vision API Key (motor principal/respaldo para lectura de dorsales y atributos visuales de ciclismo/running)
# Modelos soportados: llama-3.2-11b-vision-preview / llama-3.2-90b-vision-preview
VITE_GROQ_API_KEY=tu_api_key_de_groq_aqui

# Google Gemini API Key (para lectura inteligente de dorsales y atributos visuales en fotos deportivas)
# Obtenela gratis en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Opcional: segunda clave de respaldo de Gemini
# VITE_GEMINI_API_KEY_BACKUP=tu_api_key_backup_aqui
