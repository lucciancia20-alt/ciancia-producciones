# Variables de Entorno — Ciancia Producciones

# Google Gemini API Key (para lectura inteligente de dorsales en fotos deportivas)
# Obtenela gratis en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Opcional: forzar un modelo concreto (por defecto se autodetecta el Flash vigente, ej. gemini-flash-latest)
# VITE_GEMINI_MODEL=gemini-2.5-flash
